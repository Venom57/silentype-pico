<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.janus.silentype-app</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/silentype-app</string><string>server</string>
    <string>-o</string><string>listen-hostname=localhost</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
<!-- ~/Library/LaunchAgents/ ; launchctl load. PAPPL on macOS: build from source
     (github.com/michaelrsweet/pappl) against Homebrew libcups. -->
